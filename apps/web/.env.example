# Database Config
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maintainer?schema=public

# TrueForge Harness Server Config
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_TOKEN=
# TRUEFORGE_API_KEY=  # alias of TRUEFORGE_TOKEN

# Model API Keys (BYOK - Google AI Studio, Anthropic, OpenAI)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=google/gemini-3.1-flash-lite

# GitHub Integration (Personal Access Token with repo scope)
GITHUB_PAT=
GITHUB_TOKEN=
GITHUB_WEBHOOK_URL=http://localhost:5173/api/webhooks/github
# Webhook secret - set to any random string, passed to GitHub when registering webhooks.
# GitHub will sign all incoming webhook requests with this secret (X-Hub-Signature-256).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=

# Discord Bot (runs as a separate persistent process: npx tsx src/discord-bot.ts)
# Create app at https://discord.com/developers/applications → Bot → Token
DISCORD_BOT_TOKEN=
# Your Picto web app URL - the bot calls this to process @Picto mentions
# NOTE: When TrueForge runs in WSL and web runs on Windows (your setup),
# localhost is NOT reachable from WSL. Use the WSL gateway IP instead:
#   wsl sh -c "grep -oP '^eth0\\s+\\K\\w+' /proc/net/route" -> hex -> IP (e.g. 172.26.48.1)
# So set: PICTO_API_URL=http://172.26.48.1:5173  (your current gateway)
PICTO_API_URL=http://localhost:5173
# Secret to verify requests from the bot to your API
DISCORD_API_SECRET=

# Auth & Billing (Dummy values for local dev)
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=local-dev-secret-key-1234567890
RESEND_API_KEY=re_dummy_resend_key
GOOGLE_CLIENT_ID=dummy_google_id
GOOGLE_CLIENT_SECRET=dummy_google_secret
