# TrueForge Harness Server Config
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_KEY=

# Model API Keys (BYOK - Google AI Studio, Anthropic, OpenAI)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=google/gemini-2.5-flash-lite

# GitHub Integration (Personal Access Token with repo scope)
GITHUB_PAT=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=your_webhook_secret_key

# Webhook & Application Public URL
# (Used to generate the GitHub Webhook URL: ${VITE_APP_URL}/api/webhooks/github)
VITE_APP_URL=http://localhost:5173
GITHUB_WEBHOOK_URL=http://localhost:5173/api/webhooks/github
