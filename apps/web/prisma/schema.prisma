generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MaintainerRepo {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner           String
  name            String
  fullName        String   @unique
  webhookUrl      String
  webhookId       Int?
  status          String   @default("active")
  sandboxProvider String   @default("TrueForge Harness Sandbox")
  autoFixEnabled  Boolean  @default(true)
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workflows MaintainerWorkflow[]
  comments  MaintainerComment[]

  @@index([userId])
  @@map("maintainer_repo")
}

model MaintainerComment {
  id               String          @id @default(cuid())
  repoId           String
  repo             MaintainerRepo  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  issueNumber      Int?
  githubCommentId  String          @unique
  author           String
  body             String
  isPRReady        Boolean         @default(false)
  prNumber         Int?
  shouldNotify     Boolean         @default(false)
  notified         Boolean         @default(false)
  aiReasoning      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([repoId, issueNumber])
  @@index([shouldNotify, notified])
  @@map("maintainer_comment")
}

model MaintainerWorkflow {
  id                  String          @id @default(cuid())
  repoId              String
  repo                MaintainerRepo  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  issueUrl            String
  issueNumber         Int
  title               String
  body                String
  status              String          @default("investigating")
  state               String          @default("open")
  author              String          @default("user")
  rootCause           String?
  affectedFiles       Json?
  recommendation      String?
  riskLevel           String?         @default("low")
  prNumber            Int?
  branch              String?
  diff                String?
  prSummary           String?
  testLog             String?
  testPassed          Boolean         @default(false)
  prDecisionReasoning String?
  executionMode       String?         @default("DIRECT")
  prCreated           Boolean         @default(false)
  directPr            Boolean         @default(false)
  directPrReasoning   String?
  trueforgeSessionId  String?
  toolCallId          String?
  threadId            String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  events MaintainerEvent[]

  @@index([repoId])
  @@map("maintainer_workflow")
}

model MaintainerEvent {
  id         String             @id @default(cuid())
  workflowId String
  workflow   MaintainerWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  type       String             // repo_connected | issue_triaged | sandbox_test_passed | pr_created | approval_requested | pr_merged
  title      String
  detail     String
  timestamp  DateTime           @default(now())

  @@index([workflowId])
  @@map("maintainer_event")
}

model MaintainerSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  geminiApiKey     String?
  anthropicApiKey  String?
  openaiApiKey     String?
  githubToken      String?
  selectedModel    String   @default("google-gemini/gemini-3-5-flash-lite")
  trueforgeBaseUrl String   @default("http://localhost:8790")
  lastVisitAt      DateTime?
  discordGuildId   String?
  discordBotSessionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("maintainer_settings")
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  on_hold
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dodoSubscriptionId  String             @unique
  dodoCustomerId      String?
  productId           String
  status              SubscriptionStatus @default(active)
  planId              String             @default("starter")
  billingInterval     String             @default("monthly")
  currentPeriodEnd    DateTime?
  cancelAtNextBilling Boolean            @default(false)
  trialEndsAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId])
  @@map("subscription")
}

model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  subscriptions      Subscription[]
  forms              Form[]
  maintainerSettings MaintainerSettings?
  maintainerRepos    MaintainerRepo[]

  @@unique([email])
  @@map("user")
}

model Form {
  id          String           @id @default(cuid())
  title       String
  description String?
  preset      String           @default("amazon")
  fields      Json
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@map("form")
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())

  @@index([formId])
  @@map("form_submission")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
